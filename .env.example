# Google Maps (Geocoding + Places Autocomplete for address search)
GOOGLE_API_KEY=

# Anthropic Claude — used by /api/assessor (Playwright fetches assessor pages; Claude parses structured fields)
ANTHROPIC_API_KEY=

# PostgreSQL — /api/rent (rent comps) and /api/regrid (parcel enrichment)
# Use a connection string your runtime can reach (Railway/Heroku/etc. internal URLs only work on that network)
DATABASE_URL=

# Optional: set to 1 when the DB requires TLS (many hosted providers)
DATABASE_SSL=

# MongoDB Atlas — journey documents live in DB `Westay`, collection `User_Datas`
# (cluster display name in Atlas is separate; only the URI is used here)
mongodburl=
# MONGO_DB_NAME=Westayrffggrg

# Finish flow: PDF to admin via Gmail SMTP (app password)
# adminmail=
# apppassword=
